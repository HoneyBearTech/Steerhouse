# Settings for deploy/compose.yaml that aren't kept in ./secrets. Copy to .env and edit.

# The release to run (a tag of the published images).
STEERHOUSE_VERSION=0.10.1

# Shared by the API and the workers: a long random string (at least 32 characters), e.g.
#   openssl rand -hex 32
WORKER_TOKEN=

# Where the web UI listens. Keep it on loopback and publish it through a TLS-terminating proxy.
STEERHOUSE_BIND=127.0.0.1:8080

# Who may tell the web UI the client's address (X-Forwarded-For), which login throttling and the audit
# log use: "gateway" (a reverse proxy on this host, reaching STEERHOUSE_BIND), addresses or CIDRs of
# proxies elsewhere (comma-separated), or "none". If you publish STEERHOUSE_BIND to the network without a
# proxy, set none: otherwise clients could claim any address.
# TRUSTED_PROXIES=gateway

# The address people open Steerhouse at, e.g. https://steerhouse.example.com. Notifications link to it,
# single sign-on builds its callbacks from it, and passkeys only work there (https, or
# http://localhost to try it out).
# PUBLIC_URL=

# Global admins and project admins must set up two-factor login (an authenticator app or a passkey)
# at their next password sign-in before they can do anything else. Single sign-on is exempt.
# REQUIRE_ADMIN_2FA=true

# Cookies are only sent over HTTPS. Set to false only to try it out over plain http on localhost.
COOKIE_SECURE=true

# Add the browser's origin if it differs from the Host the backend sees (e.g. behind some proxies):
# CORS_ORIGINS=["https://steerhouse.example.com"]
# Host names the API answers to (any by default here, behind your reverse proxy); e.g.
# ALLOWED_HOSTS=["steerhouse.example.com"]

# How many runs each worker executes at once (1 to 64).
WORKER_SLOTS=2
# Runs (as the slot users) can't reach the API's container or cloud metadata services: the
# worker installs firewall rules for them (it needs the NET_ADMIN capability, as compose gives
# it). Let them reach the metadata service, for playbooks that use the host's cloud identity:
# WORKER_ALLOW_CLOUD_METADATA=true
# More addresses or networks runs must not reach, comma-separated (e.g. a pod network):
# WORKER_BLOCKED_NETWORKS=10.244.0.0/16
# Only if the workers' network is restricted some other way (a production worker without the
# filter refuses to start otherwise):
# WORKER_EGRESS_FILTER=false

# ---- Optional: Prometheus and Grafana (docker compose --profile monitoring up -d) ----
# See "Monitoring" in docs/installing.md: it also needs two files in ./secrets (grafana_admin_password and
# grafana_db_password). Turn it on by setting a token and letting the backend listen on the monitoring
# network; leave them alone (and the profile off) to run without metrics.
# A long random string the backend asks Prometheus for, e.g. openssl rand -hex 32:
# METRICS_TOKEN=
# METRICS_HOST=0.0.0.0
# Where Grafana listens. Keep it on loopback and publish it through a TLS-terminating proxy.
# GRAFANA_BIND=127.0.0.1:3000
# The address people open Grafana at (its links and cookies use it):
# GRAFANA_ROOT_URL=https://grafana.example.com
# How long Prometheus keeps its data:
# PROMETHEUS_RETENTION=30d
